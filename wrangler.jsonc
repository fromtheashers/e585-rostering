{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgroster",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // Node.js APIs the app and the pg driver use (crypto, net sockets, Buffer).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Paste the ID from Cloudflare dashboard > Hyperdrive (see README, "Deploy to Cloudflare Workers").
      "id": "29ac88490c174ce7b9743e3172621ade"
      // No localConnectionString here: for `npm run preview`, set
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .dev.vars or your shell instead.
    }
  ]
}
