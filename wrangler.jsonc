{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgroster",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // Node.js APIs the app and the pg driver use (crypto, net sockets, Buffer).
  "compatibility_flags": ["nodejs_compat"],
  // Keep variables set in the Cloudflare dashboard; without this every deploy deletes plain-text ones.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Paste the ID from Cloudflare dashboard > Hyperdrive (see README, "Deploy to Cloudflare Workers").
      "id": "29ac88490c174ce7b9743e3172621ade",
      // KEEP THIS LINE. It is a placeholder that is never used by the live app, but Cloudflare's
      // deploy step crashes without it ("you should use a local Postgres connection string").
      // For `npm run preview`, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
      "localConnectionString": "postgres://placeholder:placeholder@localhost:5432/placeholder"
    }
  ]
}
