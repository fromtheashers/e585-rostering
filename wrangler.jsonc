{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgroster",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // Node.js APIs the app and the pg driver use (crypto, net sockets, Buffer).
  "compatibility_flags": ["nodejs_compat"],
  // Keep variables set in the Cloudflare dashboard; without this every deploy deletes plain-text ones.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Paste the ID from Cloudflare dashboard > Hyperdrive (see README, "Deploy to Cloudflare Workers").
      "id": "29ac88490c174ce7b9743e3172621ade",
      // A placeholder, never used in production. `opennextjs-cloudflare deploy` (which `wrangler deploy`
      // hands over to) starts a local proxy that refuses to run without one. For `npm run preview`,
      // set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE to a real local Postgres instead.
      "localConnectionString": "postgres://placeholder:placeholder@localhost:5432/placeholder"
    }
  ]
}
