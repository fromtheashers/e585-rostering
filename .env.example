# Used by `npm run dev`, `npm start` (Render) and `npm run db:migrate`.
# Neon connection string (Neon dashboard > Connect). Keep ?sslmode=require on the end.
# On Cloudflare this is only a build variable (for the migration); the running Worker reaches
# the database through Hyperdrive instead.
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Any long random string. Signs the "signed in as" cookie. Use the same value everywhere the
# app runs (Render and Cloudflare), or everyone has to sign in again.
SESSION_SECRET=replace-with-a-long-random-string

# Only for `npm run preview` (the app running locally in the Workers runtime): the database the
# local Hyperdrive binding connects to. It must include a password, even for a local database.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:password@127.0.0.1:5432/e585
